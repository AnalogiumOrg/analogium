---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header title={SITE_TITLE} />
    <main>
      <center><h1>WELCOME TO ANALOGIUM</h1></center>
      <p>
        ANALOGIUM is a project committed to archive twisted stories, unsettling
        content of Internet, as well as the one who created them.
      </p>
      <p>
        A TV Channel where strange things happens in the night? A group of
        friends tormented by a "cult" of a mysterious figure? A forgotten PS1
        title that never came out? That sounds like a usual Saturday to me!
      </p>
    </main>
    <Footer />
  </body>
</html>
