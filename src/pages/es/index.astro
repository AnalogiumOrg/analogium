---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import i18next, { t, changeLanguage } from "i18next";
import { Trans } from "astro-i18next/components";

changeLanguage("es");
---

<!DOCTYPE html>
<html lang={i18next.language}>
	<head>
		<BaseHead title={t("web.name")} description={t("web.desc")} />
	</head>
	<body class={i18next.language}>
		<Header title={t("web.name")} />
		
		<main>
			<center><h1>{t("home.title")}</h1></center>
			<Trans i18nKey="home.subtitle">
				<p>
					ANALOGIUM is a society committed to document twisted
					universes, insane minds and creatures incomprehensible to
					the average human, as well as the souls who gave their time
					and sanity to develop them.
				</p>
				<p>
					Imagine a world where the United States harbours strange
					creatures among its monuments; imagine a county terrorised
					by '<i>Doppelgängers</i>' of its inhabitants; imagine a
					human trapped in a machine forgotten at the bottom of the
					ocean. All these and more stories neatly documented in one
					place.
				</p>
			</Trans>
		</main>
		<Footer />
	</body>
</html>
