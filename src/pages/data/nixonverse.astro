---
import { t, changeLanguage } from "i18next";
import { localizePath } from "astro-i18next";
import { Trans } from "astro-i18next/components";
import Layout from "../../layouts/BlogPost.astro";
import Tape from "../../components/Tape.vue";

changeLanguage("en");
---

<style>
	:root {
		--blood: #ff0000;
		--lunarian: #26afff;

		--blood_dark: #ff0000;
		--blood_light: #00ffff;
		--lunarian_dark: #26afff;
		--lunarian_light: #d95000;
	}
	#queen {
		font-family: "Times for Punks";
		font-style: normal;
		font-size: 1.25rem;
		color: var(--lunarian);
		line-height: 1.5rem;
	}
	#blood {
		color: var(--blood);
	}
	#nixon {
		font-family: "Astigma";
		font-style: normal;
		font-size: 1.03rem;
		line-height: 1.375rem;
	}
</style>
<Layout
	title={t("nixon.title")}
	heroImage="../../../images/data/nv_dark.png"
	description={t("nixon.desc")}
>
	<Trans i18nKey="nixon.intro">
		<p>
			<a href={localizePath("data/monument-mythos")}></a>
			<a href={localizePath("data/house-in-the-ocean")} id="hid"></a>
			<br />
			<a href="https://youtu.be/aUbsgWa2CXY" target="_blank"></a>
		</p>
	</Trans>

	<h1>{t("data.syn")}</h1>
	<Trans i18nKey="nixon.synop">
		<p>
			<b><u></u><u></u><u></u></b><b><i></i></b>
		</p>
	</Trans>

	<h1>{t("chrono.chrono")}</h1>
	<ol>
		<li>
			<a href="https://youtu.be/p18oxjNauM8" target="_blank">
				THE D-DAY KNIGHT</a
			>
		</li>
		<li>
			<a href="https://youtu.be/VdcCQmMEKtk" target="_blank"
				>THE LAST SON OF ALCATRAZ</a
			>
		</li>
		<li>
			<a href="https://youtu.be/oWyklL0biuo" target="_blank"
				>THE QUEEN OF THE LUNARIANS</a
			>
		</li>
		<li>
			<a href="https://youtu.be/DLWmWR8HrdI" target="_blank"
				>JESUS IN VIETNAM</a
			>
		</li>
		<li>
			<a href="https://youtu.be/vyxYFnxd7Q8" target="_blank"
				>THE MISSING EYE OF JESUS CHRIST</a
			>
		</li>
		<li>
			<a href="https://youtu.be/IeRZ8USiRKI" target="_blank">
				SEA OF THE LAST SON</a
			>
		</li>
		<li>
			<a href="https://youtu.be/gsXYUfw_09I" target="_blank"
				>THE D-DAY KNIGHT RETURNS</a
			>
		</li>
		<li>
			<a href="https://youtu.be/zsZwjmOe2pc" target="_blank">
				D-DAY KNIGHTFALL</a
			>
		</li>
		<li>
			<a href="https://youtu.be/nYKzDV8T58A" target="_blank">
				NIXON IS GOD</a
			>
		</li>
		<li>
			<a href="https://youtu.be/Nmi3ENEOMXQ" target="_blank"
				>THE ED DWIGHT PARADOX</a
			>
		</li>
	</ol>

	<h1>{t("data.inter")}</h1>

	<!-- PROLOGUE -->
	<Trans i18nKey="nixon.act0">
		<h3></h3>
		<p>
			<b></b><b></b><b></b>
		</p>
	</Trans>
	<blockquote>
		<img
			src="../../../images/data/endofanotherworld_dark.png"
			class="logo toggleable"
		/>
		<p>{t("nixon.block1")}</p>
	</blockquote>

	<!-- ACT I -->
	<Trans i18nKey="nixon.act1-1">
		<h3></h3>
		<p>
			<b></b><i></i>
		</p>
	</Trans>
	<blockquote>
		<img
			src="../../../images/data/hornedhelmet_dark.png"
			class="logo toggleable"
		/>
		<p>{t("nixon.block2")}</p>
	</blockquote>
	<Trans i18nKey="nixon.act1-2">
		<p>
			<b></b>
		</p>
		<p>
			<i></i>
			<br />
			<b></b><b></b>
		</p>
