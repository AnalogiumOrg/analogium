		<Tape audio="../../../audio/queen's_beauty.mp3" client:only />
		<Trans i18nKey="nixon.block3">
			<p id="queen">
				<br /><br />
				<u></u>
				<br /><br />
				<i></i>
			</p>
		</Trans>
		<img
			src="../../../images/data/containers_dark.png"
			class="logo toggleable"
		/>
	</blockquote>

	<!-- ACT II -->
	<Trans i18nKey="nixon.act2-1">
		<h3></h3>
		<p>
			<b></b><i></i><i style="font-weight: bold;"><u></u></i><b></b>
		</p>
		<p>
			<b></b>
		</p>
	</Trans>
	<blockquote>
		<img
			src="../../../images/data/itwastheonlyway_dark.png"
			class="logo toggleable"
		/>
		<Trans i18nKey="nixon.block4">
			<p>
				<br /><br />
			</p>
		</Trans>
	</blockquote>
	<Trans i18nKey="nixon.act2-2">
		<p>
			<b></b>
		</p>
		<p style="text-align: center;">
			<br /><b></b>
		</p>
	</Trans>

	<!-- ACT III -->
	<Trans i18nKey="nixon.act3-1">
		<h3></h3>
		<p>
			<b></b>.
		</p>
		<p>
			<b></b>
		</p>
	</Trans>
	<blockquote>
		<Trans i18nKey="nixon.block5">
			<p id="queen" style="font-style: italic; font-weight: bold;">
				<br /><br /><br /><br />
			</p>
		</Trans>
	</blockquote>
	<Trans i18nKey="nixon.act3-2">
		<p>
			<b><u id="blood"></u></b><b></b>
			<br />
			<b></b><i></i>
		</p>
	</Trans>
	<blockquote>
		<img
			src="../../../images/data/evolution_dark.png"
			class="logo toggleable"
		/>
		<p>{t("nixon.block6")}</p>
	</blockquote>

	<!-- ACT IV -->
	<Trans i18nKey="nixon.act4-1">
		<h3></h3>
		<p>
			<u id="queen"></u>
		</p>
		<p>
			<b></b>
		</p>
		<p>
			<b></b>
		</p>
		<p>
			<b><u id="blood"></u></b><b></b>
		</p>
	</Trans>
	<blockquote>
		<img
			src="../../../images/data/avenuefall_dark.png"
			class="logo toggleable"
		/>
		<p>{t("nixon.block7")}</p>
	</blockquote>
	<Trans i18nKey="nixon.act4-2">
