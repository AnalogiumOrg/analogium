---
import BaseHead from "../../../components/BaseHead.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import i18next, { t, changeLanguage } from "i18next";
import { Trans } from "astro-i18next/components";
import { getCollection } from "astro:content";

changeLanguage("fr");
---

<!DOCTYPE html>
<html lang={i18next.language}>
	<head>
		<BaseHead title={t("web.name")} description={t("web.desc")} />
		<style>
			ul {
				list-style-type: none;
				padding: unset;
			}
			ul li {
				display: flex;
			}
			ul li :global(time) {
				flex: 0 0 130px;
				font-style: italic;
				color: #595959;
			}
		</style>
	</head>
	<body class={i18next.language}>
		<Header />
		<main>
			<section>
				<ul>
					<li>
						•     <a href={"../data/nixonverse"}>{t("nixon.title").toUpperCase()}</a>
					</li>
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
