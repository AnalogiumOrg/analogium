---
import BaseHead from "../../../components/BaseHead.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import i18next, { t, changeLanguage } from "i18next";
import { Trans } from "astro-i18next/components";
import { getCollection } from "astro:content";

changeLanguage("fr");
---

<!DOCTYPE html>
<html lang={i18next.language}>
	<head>
		<BaseHead title={t("web.name")} description={t("web.desc")} />
		<style>
			ul {
				list-style-type: none;
				padding: unset;
			}
			ul li {
				display: flex;
			}
			ul li :global(time) {
				flex: 0 0 130px;
				font-style: italic;
				color: #595959;
			}
		</style>
	</head>
	<body class={i18next.language}>
		<Header />
		<main>
			<section>
				<ul class="data">
					<li>
						•     <a href={"../data/fnaf-vhs"}>{t("fnaf.title")}</a>
					</li>
					<li>
						•     <a href={"../data/gemini-home-entertainment"}>{t("gemini.title")}</a>
					</li>
					<li>
						•     <a href={"../data/generation-loss"}>{t("loss.title")}</a>
					</li>
					<li>
						•     <a href={"../data/local58"}>{t("local.title")}</a>
					</li>
					<li>
						•     <a href={"../data/noc+10"}>{t("noc.title")}</a>
					</li>
					<li>
						•     <a href={"../data/petscop"}>{t("petscop.title")}</a>
					</li>
					<li>
						•     <a href={"../data/house-in-the-ocean"}>{t("house.title")}</a>
					</li>
					<li>
						•     <a href={"../data/mandela-catalogue"}>{t("mandela.title")}</a>
					</li>
					<li>
						•     <a href={"../data/monument-mythos"}>{t("mythos.title")}</a>
					</li>
					<li>
						•     <a href={"../data/nixonverse"}>{t("nixon.title")}</a>
					</li>
					<li>
						•     <a href={"../data/walten-files"}>{t("walten.title")}</a>
					</li>
					<li>
						•     <a href={"../data/valle-verde"}>{t("valle.title")}</a>
					</li>
					<li>
						•     <a href={"../data/welcome-home"}>{t("welcome.title")}</a>
