---
import HeaderLink from "./HeaderLink.astro";
import Background from "../components/Background.astro";

const logo = `/images/web/Logo_light.png`;
---

<header>
	<Background />
	<h1></h1>
	<img src={logo} alt="ANALOGIUM" class="logo toggleable" />
	<h2></h2>
	<nav>
		<HeaderLink href="/">HOME</HeaderLink> •
		<HeaderLink href="/data">DATA</HeaderLink> •
		<HeaderLink href="https://twitter.com/ANALOGIUM414" target="_blank">
			TWITTER / X
		</HeaderLink> •
		<HeaderLink
			href="https://www.instagram.com/daily_meep_/"
			target="_blank"
		>
			INSTAGRAM
		</HeaderLink> •
		<HeaderLink href="https://www.youtube.com/@analogium" target="_blank">
			YOUTUBE
		</HeaderLink> •
		<HeaderLink href="/origin"> ORIGIN </HeaderLink>
	</nav>
	<br />
</header>
<style>
	header {
		margin: -1.4em 0 0em;
		text-align: center;
		align-items: center;
		justify-content: center;
	}
	h2 {
		margin: 0.5em 0;
	}
	.logo {
		width: 57.5%;
		height: 57.5%;
	}
	.text {
		width: 17rem;
		height: 4rem;
	}
</style>

<script type="module">
	let isBBT = false;
	const logo = document.querySelector(".logo");
	let audio;

	const makeBBT = () => {
		logo.src = logo.src.replace(
			"/images/web/Logo_light",
			"/images/secret/TBBTLogo_light",
		);
		setTimeout(() => {
			logo.src = logo.src.replace(
				"/images/web/Logo_light",
				"/images/secret/TBBTLogo_light",
			);
			if (audio) {
				console.log("playing");
				audio.play();
			} else {
				console.log("creating");
				audio = new Audio("/audio/secret/TBBT-Ambient.mp3");
				audio.loop = true;
				audio.play();
			}
		}, 200);
	};

	const undoBBT = () => {
		logo.src = logo.src.replace(
			"/images/secret/TBBTLogo_light",
			"/images/web/Logo_dark",
		);
		if (audio) {
			console.log("pausing");
			audio.pause();
			audio.currentTime = 0;
		}
	};

	/* useListen("THEBBTEVENT", (e) => {
		isBBT = true;
		if (logo.src.includes("_light")) {
			makeBBT();
		}
	}); */

	window.addEventListener("THEBBTEVENT", () => {
		isBBT = true;
		if (logo.src.includes("_light")) {
			makeBBT();
		}
	});

	window.addEventListener("setlightmode", () => {
		if (isBBT) {
			makeBBT();
		}
	});
	window.addEventListener("setdarkmode", () => {
		if (isBBT) {
			undoBBT();
		}
	});
</script>
