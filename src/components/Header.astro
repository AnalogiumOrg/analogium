---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<h1></h1>
	<img src="/logo.svg" class="logo" />
	<h2></h2>
	<img src="/text.png" class="text" />
	<h1></h1>
	<nav>
		<HeaderLink href="/">HOME</HeaderLink>
		<HeaderLink href="/blog">DATA</HeaderLink>
	</nav>
</header>
<style>
	header {
		margin: 0em 0 2em;
		text-align: center;
		align-items: center;
		justify-content: center;
	}
	h1, h2 {
		margin: 0.5em 0;
	}
	.logo {
		width: 18rem;
		height: 14rem;
		position: relative;
		left: 0.1rem;
	}
	.text {
		width: 17rem;
		height: 4rem;
		position: relative;
		left: 0.2rem;
	}
</style>
