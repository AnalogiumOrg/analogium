---
import HeaderLink from "./HeaderLink.astro";
import Background from "../components/Background.astro";

const logo = `/images/web/Logo_light.png`;
---

<header>
	<Background />
	<h1></h1>
	<img src={logo} alt="ANALOGIUM" class="logo toggleable" />
	<h2></h2>
	<nav>
		<HeaderLink href="/">HOME</HeaderLink> •
		<HeaderLink href="/data">DATA</HeaderLink> •
		<HeaderLink href="https://twitter.com/ANALOGIUM414" target="_blank">
			TWITTER / X
		</HeaderLink> • 
		<HeaderLink href="https://www.instagram.com/same.garfield_picture.everyday/" target="_blank">
			INSTAGRAM
		</HeaderLink> • 
		<HeaderLink href="https://www.youtube.com/@analogium" target="_blank">
			YOUTUBE
		</HeaderLink> • 
		<HeaderLink href="/origin">
			ORIGIN
		</HeaderLink>
	</nav>
	<br />
</header>
<style>
	header {
		margin: -1.4em 0 0em;
		text-align: center;
		align-items: center;
		justify-content: center;
	}
	h2 {
		margin: 0.5em 0;
	}
	.logo {
		width: 57.5%;
		height: 57.5%;
	}
	.text {
		width: 17rem;
		height: 4rem;
	}
</style>