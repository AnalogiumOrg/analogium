---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<h1/>
	<img src="/Logo_light.png" class="logo toggleable"/>
	<h2/>
	<img src="/LogoText2_light.png" class="text toggleable">
	<h1/>
	<nav>
		<HeaderLink href="/en">HOME</HeaderLink>
		<HeaderLink href="/en/data">DATA</HeaderLink>
		<HeaderLink href="https://twitter.com/ANALOGIUM414" target="_blank">TWITTER</HeaderLink>
		<HeaderLink href="https://www.youtube.com/@analogium" target="_blank">YOUTUBE</HeaderLink>
		<HeaderLink href="/en/origin">ORIGIN</HeaderLink>
		<HeaderLink href="/">LANGUAGE</HeaderLink>
	</nav>
</header>
<style>
	header {
		margin: 0em 0 2em;
		text-align: center;
		align-items: center;
		justify-content: center;
	}
	h1 {
		margin: 0.5em 0;
	}
	h2 {
		margin: 1em 0;
	}
	.logo{
		width: 18rem;
		height: 14rem;
	}
	.text{
		width: 17rem;
		height: 4rem;
	}
</style>
